{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cainfin",
  "compatibility_date": "2026-05-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Serve /404.html (with a real 404 status) for any unmatched path.
    // Without this the platform returns an empty body, so a mistyped or dead
    // link lands the visitor on a blank white page with no way back.
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
